\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{TLCcoverletter}[09/10/26 standard US business letter package]
% Adapted from Timmy Chan's original TLCcoverletter.sty
% Reformatted for a conventional US professional business-letter look.

% ---- FONT ----
% Standard business letters use a plain serif face (Times-like), not a
% sans-serif "resume" font.
\RequirePackage[T1]{fontenc}
\RequirePackage{mathptmx} % Times-like serif text & math font

% ---- MARGINS AND SPACING ----
% 1 inch margins are the US business-letter norm (vs. the 0.5in "resume" margin).
\RequirePackage[top=0.6in,bottom=0.6in,left=0.7in,right=0.7in,headheight=0pt,headsep=0pt]{geometry}
\setlength{\parskip}{0.7em}
\setlength{\parindent}{0in} % full block style: no first-line indent

% ---- COLOR / LINKS ----
% No accent color; links render as plain black text, as on a printed letter.
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\hypersetup{hidelinks}

% BOLD COMMAND (kept for compatibility with existing content files)
\newcommand{\bold}[1]{ {\bfseries #1}}

% NO PAGE NUMBER
\pagenumbering{gobble}

% SUBFILES IMPORTING
\RequirePackage{standalone}
\RequirePackage{import}

\RequirePackage[english]{babel}
\RequirePackage{blindtext} % Filler Text
